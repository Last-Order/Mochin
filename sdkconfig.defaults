# Waveshare ESP32-S3-Touch-LCD-1.54
# ESP32-S3R8, 16 MB QIO Flash, 8 MB Octal PSRAM

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 使用项目根目录的自定义分区表。8 MiB factory 分区为后续 LVGL 图片和
# 桌宠功能留出空间；当前不启用 OTA。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# The board's USB-C connector is wired to the ESP32-S3 native
# USB Serial/JTAG controller, so logs and idf.py monitor use the same COM port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 待机动画资源使用“RGB565 颜色平面 + A8 透明度平面”。显式保留软件绘制
# 支持，确保重新生成 sdkconfig 后仍能正确混合雪碧图的透明边缘。
CONFIG_LV_DRAW_SW_SUPPORT_RGB565A8=y

# 待机页顶部时钟固定使用 Montserrat 20。显式写入默认配置，确保删除
# sdkconfig 后重新生成时仍然包含该字体。
CONFIG_LV_FONT_MONTSERRAT_20=y
